                <languages/eng> , <languages/deu> ;
        rico:hasOrHadSubject       <vocabularies/ehri-terms/1074> ;
        rico:hasRecordSetType      <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#Collection> ;
        rico:history               "In the beginning of 1957 Alfred Wiener and Eva Reichmann undertook a trip to Poland. On invitation of the Comité International d’Auschwitz both participated at a conference held at the Auschwitz memorial site, and visited some related institutions and archives."@en ;
        rico:identifier            "WL3000/9/1/1" ;
        rico:isOrWasIncludedIn     <units/gb-003348-wl3000_9_1> ;
        rico:recordResourceExtent  "18 items"@en ;
        rico:scopeAndContent       "Containing internal material from The Wiener Library exclusively, the bundle includes reports on: the conference at the Auschwitz Memorial, a research stay at the Żydowsky Instytut Historyczny (Jewish Historical Institute) in Warsaw, visits at a Jewish cultural association, at the Main Commission for the Investigation of German Crimes in Poland, and at the Polish Institute of International Affairs.&nbsp;"@en ;
        rico:title                 "Correspondence regarding a trip to Poland"@en .
