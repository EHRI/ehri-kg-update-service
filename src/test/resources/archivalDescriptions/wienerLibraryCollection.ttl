        a                          ehri:RecordSet ;
        rdfs:seeAlso               <https://wiener.soutron.net/Portal/Default/en-GB/RecordView/Index/104218> ;
        rico:conditionsOfUse       "<strong style\"text-decoration-color: initial; box-sizing: border-box; color: #ff0000; font-family: Roboto, sans-serif; font-size: 15px; text-align: left\">This material has been digitised. Readers should book a reading room terminal to access it.</strong>"@en ;
