<vocabularies/ehri-cb/005433>
        a                       ehri:CorporateBody ;
        ehri:sources            "The Jewish Virtual Library (retrieved on 29/10/2017)\r\nhttp://www.jewishvirtuallibrary.org/jewish-telegraphic-agency-jta"@en ;
        rico:date               "1917 - Present" ;
        rico:hasBeginningDate   <dates/1917> ;
        rico:hasOrHadAgentName  <vocabularies/ehri-cb/005433/otherNames/J.T.A.> ;
        rico:history            "The Jewish Telegraphic Agency - former Jewish Correspondence Bureau - was created by the journalist Jacob Landau with the purpose of collecting and disseminating news among and affecting the Jewish communities of the diaspora. \r\n"@en ;
        rico:name               "Jewish Telegraphic Agency (JTA)"@en .

