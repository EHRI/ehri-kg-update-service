PREFIX ehri: <http://lod.ehri-project-test.eu/ontology#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>

SELECT DISTINCT ?s WHERE {
  ?s ?p ?o ;
    a ehri:Country .
  # this avoids conflicts with data created by the institution mapping rules
  FILTER(?p != rico:containsTransitive && ?p != rico:isOrWasLocationOfAgent)
}