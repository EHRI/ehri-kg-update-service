####################
### Vocabularies ###
####################

ehri_terms:1
        a skos:Concept ;
        schema:sameAs <https://n2t.net/ark:41045/p0000000000011> ;
        rico:isOrWasSubjectOf ehri_units:be-000001-kd_00001 ;
