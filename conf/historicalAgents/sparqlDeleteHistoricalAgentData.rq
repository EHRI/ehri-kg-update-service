PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX ehri: <http://lod.ehri-project-test.eu/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX ehri_vocabs: <http://lod.ehri-project-test.eu/vocabularies/>

DELETE {
    ?s ?p ?o .
} WHERE {
    {
        # All the main triples where the concept is the subject except those that are not re-generated
        ?s ?p ?o .
        FILTER(?s = ehri_vocabs:<$entityId>
            && ?p != rico:isOrWasSubjectOf
            && ?p != rico:isCreatorOf)
    }
    UNION
    {
        # Connected instances that can be completely removed as they are only bound to the institution
        ?s ?p ?o ;
            a ?connectedClasses ;
            ?inverseProperty ?agent .
        VALUES ?connectedClasses { ehri:AlternateAgentName ehri:ParallelAgentName rico:LegalStatus rico:Activity rico:Mandate }
        FILTER(?agent = ehri_vocabs:<$entityId>)
    }
    UNION
    {
        # The agent's dates, which are only bound to it (unlike the dates shared by all entities, which the mappings
        # made before)
        ?s ?p ?o ;
            a rico:Date ;
            ?inverseProperty ?agent .
        FILTER(?agent = ehri_vocabs:<$entityId> && STRSTARTS(STR(?s), CONCAT(STR(?agent), "/dates/")))
    }
    UNION
    {
        # Links from the date nodes shared by all entities, which the mappings made before dates were literals, in case
        # the KG still has them
        ?s ?p ?o .
        VALUES ?p { rico:isEndDateOf rico:isBeginningDateOf rico:isDeathDateOf rico:isBirthDateOf }
        FILTER(?o = ehri_vocabs:<$entityId>)
    }
}